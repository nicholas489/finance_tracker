# Public base URL of the app, used to build links in emails (e.g. password
# reset). Required in production; in development it falls back to the request host.
APP_URL=http://localhost:3000

# Postgres connection string. On Supabase: Connect → "Transaction pooler"
# (port 6543), with [YOUR-PASSWORD] replaced by the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
